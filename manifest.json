{
  "manifest_version": 3,
  "name": "PeekaStock",
  "version": "0.7.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://mis.twse.com.tw/*", "https://query1.finance.yahoo.com/*"],
  "background": { "service_worker": "sw.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "toggle-hide": { "suggested_key": { "default": "Alt+Shift+H" }, "description": "__MSG_cmdToggleHide__" }
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["i18n.js", "markets.js", "prefs.js", "box.js", "blank.js", "panel.js", "overlay.js"], "run_at": "document_idle" }
  ]
}
